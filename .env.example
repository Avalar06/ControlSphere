# ==========================================
# ControlSphere Environment Configuration
# ==========================================

# Project
PROJECT_NAME="ControlSphere"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Security & Authentication
# Generate a secure key in production (e.g. openssl rand -hex 32)
SECRET_KEY="super_secret_dev_key_change_in_production_min_32_chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_secure_password"
POSTGRES_DB="controlsphere"
DATABASE_URL="postgresql://postgres:postgres_secure_password@localhost:5432/controlsphere"

# CORS Configuration (JSON array format)
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'

# First Superuser / Initial Seed
FIRST_SUPERUSER_EMAIL="admin@apexfinancial.com"
FIRST_SUPERUSER_PASSWORD="AdminPassword123!"

# Evidence Storage Configuration (Phase 3)
EVIDENCE_STORAGE_ROOT="storage/evidence"
MAX_EVIDENCE_FILE_SIZE_MB=25